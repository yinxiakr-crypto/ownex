[general]
# 처음 수집을 시작할 날짜 (컴퓨터가 꺼져 있어도 이 날짜부터 이어서 모읍니다)
collection_start_date = 2026-08-10

# 검색에 쓰는 말. 쉼표로 여러 개 넣을 수 있습니다.
search_keywords = 미술전시회,전시회,미술관,특별전,뱅크시,가우디,서도호,바젤리츠

# 메일에 넣을 전시 개수 (최소 10, 더 있으면 더 넣음)
min_results = 10
max_results = 20

# 구글 캘린더에 넣을 전시 개수 (메일 10개 중 상위만)
max_calendar = 5

# 주로 볼 지역 (이 지역 전시를 먼저 고릅니다)
main_regions = 서울,안양,과천

# 표에 따로 표시할 지역
priority_regions = 서울,안양,과천,익산

# 달력에 표시를 시작할 날짜. 이 날짜 이전은 보이지 않습니다.
calendar_start_date = 2026-08-31

[test]
# true 이면 아래 기간만 시험합니다. 매일 자동 실행할 때는 false 로 바꾸세요.
enabled = false
start_date = 2026-08-31
end_date = 2026-09-03

[sources]
sac_url = https://www.sac.or.kr/site/main/program/schedule?tab=3
sac_list_url = https://www.sac.or.kr/site/main/show/show_list
artmap_url = https://artmap.pages.dev/?view=list
artbava_url = https://www.artbava.com/
sejong_url = https://www.sejongpac.or.kr/portal/performance/exhibit/performList.do?menuNo=200558
mmca_url = https://www.mmca.go.kr/exhibits/exhibitsList.do
leeum_url = https://www.leeum.org/
hoam_url = https://hoam.leeum.org/
pompidou_url = https://www.centrepompidou-hanwha.kr/
museum_url = https://www.museum.go.kr/site/main/exhiSpecialTheme/list/current
hyundai_url = https://www.thehyundai.com/html/info/culture.html
walkerhill_url = https://www.walkerhill.com/
sema_url = https://sema.seoul.go.kr/
lotte_url = https://www.lottemuseum.com/
apma_url = https://apma.amorepacific.com/
dimuseum_url = https://www.daelimmuseum.org/
ilmin_url = https://ilmin.org/
ddp_url = https://www.ddp.or.kr/
soma_url = https://www.somamuseum.org/
craft_url = https://craftmuseum.seoul.go.kr/
anyang_url = https://www.ayac.or.kr/

[google_calendar]
# 구글 캘린더 연결 후 매일 자동으로 일정을 올립니다.
enabled = true
calendar_name = Ownex

[email]
# 메일은 한 번에 한 통만 보냅니다. 안에는 전시를 최대 10~20개 적습니다.
enabled = true
# 2026-09-07 ~ 2026-09-13: 매일 한 통. 2026-09-14부터는 월요일 오전에만 한 통.
# 달력(구글 Ownex + 아이폰 파일)은 매일 아침 8시에 따로 올립니다.
daily_from = 2026-09-07
daily_until = 2026-09-13
weekly_weekday = 0
# 메일은 GitHub에서 보냅니다. 컴퓨터가 꺼져 있어도 아침 8시에 나갑니다.
cloud_primary = true
# 비우면 로그인한 그 지메일로 보냅니다.
to =

